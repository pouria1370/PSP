    "bullmq": "^5.64.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.0.0",
    "helmet": "^6.0.0",
    "ioredis": "^5.8.2",
    "node-fetch": "2",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.0.0",
    "sqlite3": "^5.0.11",
    "typeorm": "^0.3.12",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@nestjs/config": "^4.0.2",
    "@types/node-fetch": "^2.6.13",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
